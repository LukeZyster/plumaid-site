# ─── Public site ──────────────────────────────────────────────
# Your live URL (used in email links). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET. Server only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin access ─────────────────────────────────────────────
# Comma-separated emails allowed into /admin (must also exist as Supabase Auth users)
ADMIN_EMAILS=plumaidwlt@gmail.com
# Long random string. Protects the calendar feed URL: /api/calendar/<this>.ics
CALENDAR_FEED_SECRET=change-me-to-a-long-random-string

# ─── Email (SMTP) ─────────────────────────────────────────────
# Gmail: enable 2-step verification, then create an "App password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=plumaidwlt@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="PlumAid Plumbing <plumaidwlt@gmail.com>"
# Where new-appointment notifications go
PLUMBER_EMAIL=plumaidwlt@gmail.com

# ─── Optional: push appointments straight into Google Calendar ─
# 1. Create a service account, download its JSON key
# 2. Share the plumber's Google Calendar with the service account email ("Make changes to events")
# 3. Paste the whole JSON on ONE line below, plus the calendar id (usually the Gmail address)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=plumaidwlt@gmail.com
